# =========================================================
# /etc/systemd/system/finance.service
# 家庭账房 v0.1 · Spring Boot 应用 systemd unit
#
# 安装:
#   sudo install -m 644 deploy/finance.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable finance
#   sudo systemctl start finance
#   sudo journalctl -u finance -f       # 看日志
# =========================================================
[Unit]
Description=Family Finance Web App (Spring Boot)
After=network.target mysql.service
Wants=mysql.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=finance
Group=finance
WorkingDirectory=/opt/finance
EnvironmentFile=/etc/finance.env
ExecStart=/usr/lib/jvm/java-21-openjdk-amd64/bin/java \
    -Xms256m -Xmx512m \
    -Dfile.encoding=UTF-8 \
    -Duser.timezone=Asia/Shanghai \
    -Dspring.profiles.active=prod \
    -jar /opt/finance/app.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

# Resource caps — 单家庭使用,限制保守
LimitNPROC=512
LimitNOFILE=4096
MemoryMax=1400M
# 说明:OpenD(富途网关)是应用自管的子进程,和 JVM 同处本 unit 的 cgroup,
# 一起算进 MemoryMax;1G 偏紧,给到 1400M(JVM~750M + OpenD~400M 之下)。

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# ReadWritePaths:PrivateTmp/ProtectSystem/ProtectHome 下的可写白名单(会在只读挂载上打洞)。
# · /var/finance/futu-opend = OpenD 安装文件家目录(持久,不放私有 /tmp,重启不丢;见 FUTU_OPEND_HOME)
# · /home/finance = OpenD 运行时按 getpwuid 家目录建 ~/.com.futunn.FutuOpenD(无视 $HOME),
#   ProtectHome=read-only 会锁死它 → 必须放开;其它 home(/root 等)仍只读。
# · /var/backup/finance = v1.32「管理 → 备份 → 立即备份」由应用自己跑 mysqldump 写到这里(与每周自动备份同一个目录,
#   一起按保留天数滚动删除);deploy.sh 建这个目录时属主就是 finance。前缀「-」= 目录不存在时忽略
#   (否则整个服务起不来 —— 白名单里有不存在的路径,systemd 会拒绝建挂载命名空间)。
ReadWritePaths=/opt/finance/logs /var/finance/uploads /var/finance/futu-opend /home/finance /tmp -/var/backup/finance

[Install]
WantedBy=multi-user.target
